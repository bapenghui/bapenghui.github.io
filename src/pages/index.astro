---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate, isPublicEntry, sortByUpdatedDesc } from '../lib/content-utils';
import { PROJECT_STATUS } from '../lib/project-status';

const projects = sortByUpdatedDesc(
  (await getCollection('projects')).filter(({ data }) => isPublicEntry(data) && data.featured),
).slice(0, 3);
const writing = sortByUpdatedDesc(
  (await getCollection('writing')).filter(({ data }) => isPublicEntry(data) && data.featured),
).slice(0, 2);
const photos = sortByUpdatedDesc(
  (await getCollection('photos')).filter(({ data }) => isPublicEntry(data) && data.featured),
).slice(0, 3);
---

<BaseLayout pageClass="overview-page">
  <div class="workspace-home shell">
    <div class="workspace-topbar">
      <p><span aria-hidden="true"></span> 正在建设中的个人数字花园</p>
      <a class="workspace-status" href="/now/">
        <span aria-hidden="true"></span>
        <strong>现在</strong>
        内容持续更新
        <span aria-hidden="true">↗</span>
      </a>
      <a class="workspace-source" href="https://github.com/bapenghui/bapenghui.github.io">查看源码 ↗</a>
    </div>

    <section class="workspace-welcome" aria-labelledby="welcome-heading">
      <header class="workspace-welcome-copy">
        <p class="workspace-kicker">Hello / 你好</p>
        <h1 id="welcome-heading">今天，<em>从这里</em>开始。</h1>
        <p>项目持续推进，想法持续记录，也留下沿途看见的画面。</p>
      </header>

      <article class="workspace-welcome-note dashboard-card dashboard-now">
        <header class="dashboard-card-heading">
          <h2>现在</h2>
          <span class="dashboard-live"><span aria-hidden="true"></span> 进行中</span>
        </header>
        <a class="dashboard-now-link" href="/now/">
          <strong>构建个人数字空间，研究机器人 Agent 与边缘视觉。</strong>
          <span>查看当前关注与下一步 <span aria-hidden="true">↗</span></span>
        </a>
      </article>
    </section>

    <section class="workspace-section workspace-focus" aria-labelledby="focus-heading">
      <header class="workspace-section-heading">
        <div>
          <h2 id="focus-heading">今天要看的事</h2>
          <p>{projects.length} 个项目推进中，{writing.length} 篇近期记录。</p>
        </div>
        <a href="/projects/">浏览全部 <span aria-hidden="true">↗</span></a>
      </header>

      <div class="workspace-board">
        <article class="dashboard-card dashboard-projects">
          <header class="dashboard-card-heading">
            <h3>近期项目</h3>
            <span>{projects.length}</span>
          </header>
          <ul class="dashboard-project-list">
            {projects.map(({ data, id }, index) => (
              <li>
                <a class="dashboard-project-row" href={`/projects/${id}/`} data-accent={data.accent}>
                  <span class="dashboard-check" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                  <span class="dashboard-row-copy">
                    <strong>{data.title}</strong>
                    <small>{data.summary}</small>
                  </span>
                  <span class="dashboard-row-meta">
                    <span>{PROJECT_STATUS[data.status]}</span>
                    <time datetime={data.updatedAt.toISOString()}>{formatDate(data.updatedAt)}</time>
                  </span>
                  <span class="dashboard-arrow" aria-hidden="true">↗</span>
                </a>
              </li>
            ))}
          </ul>
        </article>

        <article class="dashboard-card dashboard-writing">
          <header class="dashboard-card-heading">
            <h3>最近写作</h3>
            <a href="/writing/">全部 <span aria-hidden="true">↗</span></a>
          </header>
          <ul class="dashboard-writing-list">
            {writing.map(({ data, id }) => (
              <li>
                <a href={`/writing/${id}/`}>
                  <span>{data.category} · {data.readingMinutes} 分钟</span>
                  <strong>{data.title}</strong>
                  <time datetime={data.publishedAt.toISOString()}>{formatDate(data.publishedAt)}</time>
                  <span class="dashboard-writing-arrow" aria-hidden="true">↗</span>
                </a>
              </li>
            ))}
          </ul>
        </article>

      </div>
    </section>

    <section class="workspace-section workspace-glance" aria-labelledby="glance-heading">
      <header class="workspace-section-heading">
        <div>
          <h2 id="glance-heading">个人内容一览</h2>
          <p>项目、写作与视觉记录，都从这里进入。</p>
        </div>
      </header>

      <div class="workspace-glance-grid">
        <a class="glance-card glance-projects" href="/projects/">
          <span>公开项目</span>
          <strong>{projects.length}</strong>
          <small>持续整理工程过程</small>
        </a>
        <a class="glance-card glance-notes" href="/writing/">
          <span>近期写作</span>
          <strong>{writing.length}</strong>
          <small>技术笔记与长期思考</small>
        </a>
        <a class="glance-card glance-photos" href="/photos/">
          <span>最近图片</span>
          <span class="glance-photo-strip">
            {photos.map(({ data }) => <img src={data.src} alt={data.alt} loading="lazy" />)}
          </span>
          <small>{photos.length} 组视觉记录 <span aria-hidden="true">↗</span></small>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
