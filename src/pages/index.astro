---
import { getCollection } from 'astro:content';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import WritingCard from '../components/WritingCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { isPublicEntry, sortByUpdatedDesc } from '../lib/content-utils';

const projects = sortByUpdatedDesc(
  (await getCollection('projects')).filter(({ data }) => isPublicEntry(data) && data.featured),
).slice(0, 3);
const writing = sortByUpdatedDesc(
  (await getCollection('writing')).filter(({ data }) => isPublicEntry(data) && data.featured),
).slice(0, 2);
const photos = sortByUpdatedDesc(
  (await getCollection('photos')).filter(({ data }) => isPublicEntry(data) && data.featured),
).slice(0, 3);
---

<BaseLayout pageClass="overview-page">
  <div class="home-dashboard shell">
    <section class="home-hero">
      <div class="home-hero-main">
        <p class="eyebrow">Engineer · Builder · Observer</p>
        <h1>Bapenghui</h1>
        <p>记录技术、项目、写作，以及正在发生的事情。</p>
      </div>
      <div class="home-hero-index" aria-label="站点栏目说明">
        <span>01—04</span>
        <p>四个持续更新的个人模块</p>
      </div>
    </section>

    <div class="home-overview" aria-label="总览模块">
      <section class="home-module home-module-projects">
        <SectionHeading eyebrow="01 / Selected projects" title="最近推进的项目" href="/projects/" linkLabel="进入项目" />
        <div class="project-list">
          {projects.map((project, index) => <ProjectCard project={project} index={index} />)}
        </div>
      </section>

      <section class="home-module home-module-writing">
        <SectionHeading eyebrow="02 / Recent writing" title="最近写下的内容" href="/writing/" linkLabel="进入写作" />
        <div class="writing-list home-writing">
          {writing.map((entry) => <WritingCard entry={entry} />)}
        </div>
      </section>

      <section class="home-module home-module-now">
        <SectionHeading eyebrow="03 / Now" title="此刻正在发生" href="/now/" linkLabel="查看现在" />
        <div class="home-now-status">
          <p><span aria-hidden="true"></span> 当前正在进行</p>
          <strong>构建个人数字空间，研究机器人 Agent 与边缘视觉。</strong>
          <p>持续整理项目进展、学习方向和接下来要解决的问题。</p>
        </div>
      </section>

      <section class="home-module home-module-photos">
        <SectionHeading eyebrow="04 / Visual notes" title="最近留下的画面" href="/photos/" linkLabel="进入图片" />
        <div class="home-photos">
          {photos.map(({ data }) => (
            <figure>
              <img src={data.src} alt={data.alt} loading="lazy" />
              <figcaption>{data.title}<span>{data.category}</span></figcaption>
            </figure>
          ))}
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
