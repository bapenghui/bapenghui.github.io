---
import { NAV_ITEMS, SITE } from '../site';

interface Props {
  pathname: string;
}

const { pathname } = Astro.props;
const isCurrent = (href: string) => href === '/' ? pathname === '/' : pathname.startsWith(href);
const navMarks = ['✦', '↗', '¶', '▦', '●'];
---

<header class="site-header">
  <div class="nav-shell">
    <a class="wordmark" href="/" aria-label={`${SITE.name} 首页`}>
      <span class="wordmark-mark" aria-hidden="true">BP</span>
      <span class="wordmark-copy">
        <strong>{SITE.name}</strong>
        <small>Digital garden</small>
      </span>
    </a>
    <nav aria-label="主导航">
      <p class="nav-label">Workspace</p>
      <ul class="nav-list">
        {NAV_ITEMS.map((item, index) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              <span class="nav-index" aria-hidden="true">{navMarks[index]}</span>
              <span>{item.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <p class="rail-caption"><span aria-hidden="true"></span> Open to curiosity<br />持续记录与生长</p>
  </div>
</header>
